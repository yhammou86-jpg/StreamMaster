# Torbox API Configuration
TORBOX_API_KEY=your_torbox_api_key_here
TORBOX_API_URL=https://api.torbox.app/v1/api

# P2P Mode - Enable for users without debrid service
# When enabled, users can stream directly via WebTorrent without Torbox API
P2P_MODE=false

# Server Configuration
PORT=7000
HOST=127.0.0.1

# Addon Configuration
ADDON_NAME=Torbox Stremio Addon
ADDON_DESCRIPTION=Stream torrents and usenet content via Torbox

# Cache Configuration (in seconds)
CACHE_TTL=3600
CACHE_CHECK_PERIOD=600

# Rate Limiting
SCRAPER_RATE_LIMIT=5
SCRAPER_RATE_INTERVAL=1000

# Scraper Configuration
# 8 powerful scrapers - beats Debridio!
# Available: 1337x, thepiratebay, torrentgalaxy, rarbg, yts, eztv, nyaa, torrentdownloads
ENABLED_SCRAPERS=1337x,thepiratebay,torrentgalaxy,rarbg,yts,eztv

# Timeouts (in milliseconds)
TORBOX_TIMEOUT=30000
SCRAPER_TIMEOUT=10000

# Debug
DEBUG=false
